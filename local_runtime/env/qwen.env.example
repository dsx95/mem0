# 阿里云百炼北京地域：qwen-plus + text-embedding-v4（1024 维）。
# 只需填写下面这一处百炼北京地域 API Key，两个模型共用。
MEM0_PROVIDER_API_KEY=

# 固定预设标识，无需修改；模型和接口地址自动加载。
MEM0_PRESET=qwen

# 可选：独立重排序。修改后重启服务生效；关闭时不调用排序 API。
MEM0_RERANK_ENABLED=false
# Qwen 北京预设可复用上面的 MEM0_PROVIDER_API_KEY。
MEM0_RERANK_MODEL=qwen3-rerank
MEM0_RERANK_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
# 新业务空间可使用：https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
# 自定义地址/其他平台须显式提供 Key。不得把聊天接口地址填在这里。
MEM0_RERANK_API_KEY=
MEM0_RERANK_TIMEOUT=3
MEM0_RERANK_CANDIDATES=30
MEM0_RERANK_TOP_N=8
