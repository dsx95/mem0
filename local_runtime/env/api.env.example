# OpenAI-compatible cloud endpoints. Set models and keys before check/add/search.
# These values are loaded as data; do not source this file as a shell script.
MEM0_LLM_PROVIDER=openai
MEM0_LLM_BASE_URL=https://api.openai.com/v1
MEM0_LLM_MODEL=
MEM0_LLM_API_KEY=
MEM0_LLM_TEMPERATURE=0.1
MEM0_LLM_MAX_TOKENS=2048
MEM0_LLM_IS_REASONING_MODEL=auto

# May use a different vendor, host and key from the LLM.
MEM0_EMBEDDING_PROVIDER=openai
MEM0_EMBEDDING_BASE_URL=https://api.openai.com/v1
MEM0_EMBEDDING_MODEL=text-embedding-3-small
MEM0_EMBEDDING_API_KEY=
MEM0_EMBEDDING_DIMS=1536
# Enable only if your embedding endpoint supports the optional dimensions field.
MEM0_EMBEDDING_SEND_DIMENSIONS=false

MEM0_REQUEST_TIMEOUT=30
MEM0_MAX_RETRIES=1
MEM0_DATA_DIR=.data
# Empty: derive collection name from embedding provider, URL, model and dimensions.
MEM0_COLLECTION=
MEM0_CUSTOM_INSTRUCTIONS=用中文记录用户明确表达的长期事实、偏好和目标，跳过寒暄与猜测。
