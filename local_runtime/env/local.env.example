# Self-hosted OpenAI-compatible servers (e.g. vLLM/SGLang).
# Addresses and dimensions are examples; replace them with the actual deployments.
MEM0_LLM_PROVIDER=openai
MEM0_LLM_BASE_URL=http://127.0.0.1:8000/v1
MEM0_LLM_MODEL=CHANGE_ME_TO_SERVED_MODEL_NAME
MEM0_LLM_API_KEY=local-unused
MEM0_LLM_TEMPERATURE=0.1
MEM0_LLM_MAX_TOKENS=2048
MEM0_LLM_IS_REASONING_MODEL=false

MEM0_EMBEDDING_PROVIDER=openai
MEM0_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
MEM0_EMBEDDING_MODEL=CHANGE_ME_TO_SERVED_EMBEDDING_MODEL
MEM0_EMBEDDING_API_KEY=local-unused
MEM0_EMBEDDING_DIMS=1024
MEM0_EMBEDDING_SEND_DIMENSIONS=false

MEM0_REQUEST_TIMEOUT=30
MEM0_MAX_RETRIES=1
MEM0_DATA_DIR=.data
MEM0_COLLECTION=
MEM0_CUSTOM_INSTRUCTIONS=用中文记录用户明确表达的长期事实、偏好和目标，跳过寒暄与猜测。
