# Native Ollama API. Models must already be installed on that Ollama server.
# This runtime checks /api/tags and does not initiate model downloads.
MEM0_LLM_PROVIDER=ollama
MEM0_LLM_BASE_URL=http://127.0.0.1:11434
MEM0_LLM_MODEL=CHANGE_ME_TO_INSTALLED_OLLAMA_MODEL
MEM0_LLM_API_KEY=
MEM0_LLM_TEMPERATURE=0.1
MEM0_LLM_MAX_TOKENS=2048

MEM0_EMBEDDING_PROVIDER=ollama
MEM0_EMBEDDING_BASE_URL=http://127.0.0.1:11434
MEM0_EMBEDDING_MODEL=CHANGE_ME_TO_INSTALLED_EMBEDDING_MODEL
MEM0_EMBEDDING_API_KEY=
MEM0_EMBEDDING_DIMS=768
MEM0_EMBEDDING_SEND_DIMENSIONS=false

MEM0_REQUEST_TIMEOUT=30
MEM0_MAX_RETRIES=1
MEM0_DATA_DIR=.data
MEM0_COLLECTION=
MEM0_CUSTOM_INSTRUCTIONS=用中文记录用户明确表达的长期事实、偏好和目标，跳过寒暄与猜测。
